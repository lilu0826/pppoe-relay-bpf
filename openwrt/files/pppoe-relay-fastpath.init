#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
START=50
STOP=50
USE_PROCD=1

start_service() {
    local OPTIONS=""
    [ -r /etc/default/pppoe-relay-fastpath ] && . /etc/default/pppoe-relay-fastpath
    [ -n "$OPTIONS" ] || return 0
    procd_open_instance
    # Intentional word splitting: OPTIONS contains separate CLI arguments.
    procd_set_param command /usr/sbin/pppoe-relay -F $OPTIONS
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
