#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
START=50
STOP=50
USE_PROCD=1

start_service() {
	local OPTIONS=""
	[ -r /etc/default/pppoe-relay-bpf ] && . /etc/default/pppoe-relay-bpf
	[ -n "$OPTIONS" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/pppoe-relay-bpf $OPTIONS
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
